@using Microsoft.AspNetCore.Mvc.Rendering
@model List<WebApplication1.Models.Product>

@{
    ViewData["Title"] = "Товары";
}

<style>
    table { border-collapse: collapse; }
    table, th, td { border: 1px solid #ccc; padding: 5px; }
</style>

<h1>Товары</h1>

<p>
    <a asp-action="Create">Добавить товар</a>
</p>

<form asp-action="Index" method="get">
    @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "Все категории")
    <button type="submit">Показать</button>
</form>

@if (!Model.Any())
{
    <p>Товаров пока нет.</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Название</th>
            <th>Категория</th>
            <th>Цена</th>
            <th>Артикул</th>
            <th>В наличии</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category?.Name</td>
                <td>@item.Price</td>
                <td>@item.Sku</td>
                <td>@(item.InStock ? "да" : "нет")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Изменить</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}